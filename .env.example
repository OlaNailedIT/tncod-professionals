# Local / development. Never commit real credentials.
# PUBLIC ENVIRONMENT VARIABLES ≠ SERVER SECRETS
# Never put service_role, database password, or private keys in NEXT_PUBLIC_*

# Prisma / Postgres (server-only)
# Placeholder / vanilla local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tncod_professionals?schema=public"
# After `npx supabase start`, the disposable local database is typically:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# DIRECT_URL=

# Browser-safe Supabase (anon key only)
# After `npx supabase start`, set these from local status (gitignored `.env`).
# Do not wrap the URL in extra quotes. Never put service_role in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Never NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
# Local disposable only. Do NOT use service_role as a Phase 18 production preflight substitute.

# --- Phase 18 production credentials (gitignored real values only; never commit) ---
# READ-ONLY PREFLIGHT (required before production reconciliation):
# Prefer a dedicated least-privilege PostgreSQL role with SELECT only.
# PHASE18_PRODUCTION_DATABASE_URL="postgresql://phase18_ro:...@<prod-host>:5432/postgres?sslmode=require"
# PRODUCTION_DATABASE_URL=   # accepted alias for the same read-only connection
#
# Do NOT set for preflight:
# - write-capable DB roles
# - Supabase service_role (Auth admin)
# - Storage credentials
#
# IMPORT (separate gate — only after preflight PASS + "AUTHORIZE PHASE 18 PRODUCTION IMPORT"):
# PHASE18_IMPORT_DATABASE_URL=   # write-capable DB role, separate from read-only
# Auth admin capability TBD after CREATE_NEW count is known — never reuse preflight URL
